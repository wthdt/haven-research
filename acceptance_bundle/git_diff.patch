+-+            ),
+-+            "first_half_mdd_improvement": (
+-+                first["max_drawdown"] - baseline_first["max_drawdown"]
+-+            ),
+-+            "second_half_mdd_improvement": (
+-+                second["max_drawdown"] - baseline_second["max_drawdown"]
