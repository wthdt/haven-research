+-+    qqq_high = data["qqq_high"]
+-+    qqq_low = data["qqq_low"]
+-+    qqq_close = data["qqq_close"]
+-+    adx14 = _adx(qqq_high, qqq_low, qqq_close)
+-+    qqq_ma20 = qqq_close.rolling(20).mean()
