+-+    panic_components = {
+-+        "drawdown_63": (_stress_score(_pct(drawdown_63, config)), 0.12),
+-+        "drawdown_252": (_stress_score(_pct(drawdown_252, config)), 0.10),
+-+        "below_ma200": (_stress_score(_pct(below_ma200, config)), 0.08),
