+-+        "credit_proxy",
+-+        "cash_total_return",
+-+        "cash_yield_pct",
+-+    ]
+-+    coverage = evaluation[required].notna().mean()
+-+    failed = coverage[coverage < 0.98]
+-+    if not failed.empty:
+-+        raise RuntimeError(f"核心数据覆盖率不足：{failed.to_dict()}")
