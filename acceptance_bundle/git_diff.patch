+-+
+-+    realized_vol_20 = returns_1.rolling(20).std() * np.sqrt(252.0) * 100.0
+-+    iv_minus_rv = vxn - realized_vol_20
+-+    premium_components = {
+-+        "iv_percentile": (_pct(vxn, config), 0.35),
