-+    def close_group_quantity(
-+        date: pd.Timestamp,
-+        group: OptionGroup,
-+        quantity: int,
-+        reason: str,
-+        settle_at_expiry: bool = False,
-+    ) -> tuple[float, float]:
-+        quantity = min(quantity, group.current_contracts)
-+        if quantity <= 0:
-+            return 0.0, 0.0
-+        market = proxy_inputs.loc[date]
-+        pnl = 0.0
-+        execution_drag = 0.0
