-+            quote = option_quote(
-+                date,
-+                leg.expiry,
-+                leg.strike,
-+                leg.option_type,
-+                market,
-+                option_config,
-+                asset_symbol,
-+            )
-+            if settle_at_expiry:
-+                execution_price = quote.mid
-+                leg_commission = 0.0
-+            else:
-+                execution_price = quote.bid if leg.side > 0 else quote.ask
-+                leg_commission = commission * quantity
-+            cash_flow = (
-+                leg.side * execution_price * multiplier * quantity
-+            )
-+            leg_pnl = (
-+                leg.side
-+                * (execution_price - quote.mid)
-+                * multiplier
-+                * quantity
-+                - leg_commission
