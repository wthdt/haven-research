+def _percent(value: float, digits: int = 2) -> str:
+    if pd.isna(value):
+        return "N/A"
+    return f"{value * 100:.{digits}f}%"
+
+
+def _number(value: float, digits: int = 2) -> str:
+    if pd.isna(value):
+        return "N/A"
+    return f"{value:.{digits}f}"
+
+
