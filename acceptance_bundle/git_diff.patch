+-+        )
+-+        self.assertGreater(
+-+            enriched["implied_volatility"].notna().mean(), 0.80
+-+        )
+-+
+-+    def test_breadth_summary_has_data_guard(self) -> None:
+-+        rows = pd.DataFrame(
