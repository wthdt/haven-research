+-+    def test_implied_volatility_round_trip(self) -> None:
+-+        price, _ = black_scholes_price_delta(
+-+            100.0, 95.0, 45.0 / 365.0, 0.04, 0.01, 0.32, "put"
+-+        )
+-+        recovered = implied_volatility(
